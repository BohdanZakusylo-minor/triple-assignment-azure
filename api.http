@receivedJobId = 
###############################################################################
# RequestImageGeneration – start a new image generation job (POST)
# Returns 202 with jobId and status "QUEUED". Use jobId with GetJobStatus.
###############################################################################
POST {{baseUrl}}/api/RequestImageGeneration?code={{functionKeyRequestJob}}
Content-Type: application/json

###############################################################################
# GetJobStatus – get job progress and SAS links to finished images (GET)
# Returns 200 with jobId, status, completed, total, and outputs (array of { name, url } with time-limited SAS URLs).
###############################################################################
GET {{baseUrl}}/api/GetJobStatus?jobId={{receivedJobId}}&code={{functionKeyGetJob}}
